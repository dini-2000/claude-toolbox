  "code": {"markup": "pre.pc-code", "example": 14, "use": "A short listing beside its explanation"},
  "checklist": {"markup": "ul.pc-checks", "example": 15, "use": "Tasks done, open and dropped, with status chips"},
  "table": {"markup": "table.pc-table", "example": 18, "use": "Figures in rows, with a total"},
  "steps": {"markup": "ol.pc-steps", "example": 22, "use": "A process in three to five steps"},
