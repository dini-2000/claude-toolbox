{
 "name": "Litera",
 "summary": "A bookish serif for reading, a clean sans for headings, plenty of white space and a calm blue. Thoughtful and easy to follow, for lectures, literature reviews, essays and long reports.",
 "good_for": [
  "lecture",
  "review",
  "essay",
  "report",
  "thesis",
  "reading"
 ],
 "category": "academic",
 "also": [
  "editorial"
 ],
 "credit": "colours from Bootswatch Litera by Thomas Park (MIT licence)",
 "defaults": {
  "mode": "light",
  "palette": "blue"
 },
 "fonts": {
  "display": [
   "Instrument Sans",
   "sans"
  ],
  "body": [
   "Lora",
   "serif"
  ],
  "label": [
   "Instrument Sans",
   "sans"
  ],
  "stat": [
   "Instrument Sans",
   "sans"
  ],
  "mono": [
   "IBM Plex Mono",
   "mono"
  ]
 },
 "tokens": {
  "--w-display": "600",
  "--w-h1": "600",
  "--w-h2": "600",
  "--w-body": "400",
  "--w-strong": "700",
  "--w-label": "600",
  "--w-stat": "600",
  "--track-display": "-0.02em",
  "--track-h1": "-0.01em",
  "--track-label": "0.06em",
  "--label-case": "uppercase",
  "--lh-display": "1.06",
  "--lh-h1": "1.12",
  "--lh-body": "1.6",
  "--radius": "4px",
  "--radius-sm": "3px",
  "--border-w": "1px",
  "--card-pad": "36px",
  "--icon-stroke": "1.75"
 },
 "modes": {
  "light": {
   "bg": "#FFFFFF",
   "bg_alt": "#F8F9FA",
