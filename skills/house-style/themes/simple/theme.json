{
 "name": "Simple",
 "summary": "Black on white with one deep blue, a compact news sans for headings and almost no decoration. Plain and fast to read, for working sessions, internal updates, notes and quick explainers.",
 "good_for": [
  "update",
  "explainer",
  "notes",
  "working-session",
  "lecture",
  "memo"
 ],
 "category": "minimal",
 "credit": "colours and fonts from the reveal.js Simple theme by Hakim El Hattab and contributors (MIT licence)",
 "defaults": {
  "mode": "light",
  "palette": "blue"
 },
 "fonts": {
  "display": [
   "News Cycle",
   "sans"
  ],
  "body": [
   "Lato",
   "sans"
  ],
  "label": [
   "News Cycle",
   "sans"
  ],
  "stat": [
   "News Cycle",
   "sans"
  ],
  "mono": [
   "Source Code Pro",
   "mono"
  ]
 },
 "tokens": {
  "--w-display": "700",
  "--w-h1": "700",
  "--w-h2": "700",
  "--w-body": "400",
  "--w-strong": "700",
  "--w-label": "700",
  "--w-stat": "700",
  "--track-display": "-0.01em",
  "--track-h1": "0em",
  "--track-label": "0.04em",
  "--label-case": "uppercase",
  "--lh-display": "1.04",
  "--lh-h1": "1.1",
  "--lh-body": "1.5",
  "--radius": "2px",
  "--radius-sm": "2px",
  "--border-w": "1px",
  "--card-pad": "34px",
  "--icon-stroke": "1.75"
 },
 "modes": {
  "light": {
