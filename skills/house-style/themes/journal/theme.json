   "#7FA8D1",
   "#6FD08C",
   "#F5A04D",
   "#C39BD3",
   "#A9A6A0"
  ]
 },
 "art": {
  "deck": {
   "cover": [
    {
     "motif": "bar",
     "at": "t",
     "size": 14,
     "color": "accent"
    },
    {
     "motif": "rule",
     "at": "tl",
     "w": "calc(100% - 2 * var(--mx))",
     "h": 3,
     "x": "var(--mx)",
     "y": 44,
     "color": "ink"
    }
   ],
   "section": [
    {
     "motif": "rule",
     "at": "tl",
     "w": "calc(100% - 2 * var(--mx))",
     "h": 3,
     "x": "var(--mx)",
     "y": 44,
     "color": "ink"
    },
    {
     "motif": "rule",
     "at": "tl",
     "w": "calc(100% - 2 * var(--mx))",
     "h": 1,
     "x": "var(--mx)",
     "y": 54,
     "color": "ink"
    }
   ],
   "statement": [
    {
     "motif": "rule",
     "at": "tl",
     "w": 120,
     "h": 8,
     "x": "var(--mx)",
     "y": 90,
     "color": "accent"
    }
   ],
   "closing": [
    {
     "motif": "bar",
     "at": "b",
     "size": 14,
     "color": "accent"
    },
    {
     "motif": "rule",
     "at": "bl",
     "w": "calc(100% - 2 * var(--mx))",
     "h": 3,
     "x": "var(--mx)",
     "y": 44,
     "color": "ink"
    }
   ]
  },
  "kicker": "underline",
  "cards": "flat",
  "doc": {
   "cover": [
    {
     "motif": "bar",
     "at": "t",
     "size": 4,
     "color": "accent"
    },
    {
     "motif": "rule",
     "at": "tl",
     "w": "100%",
     "h": 0.8,
     "x": 0,
     "y": 9,
     "color": "ink"
    }
   ],
   "opener": [
    {
     "motif": "rule",
     "at": "tl",
     "w": "100%",
     "h": 0.8,
     "x": 0,
     "y": 0,
     "color": "ink"
    }
   ],
   "mark": {
