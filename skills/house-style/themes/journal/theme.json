{
 "name": "Journal",
 "summary": "A newspaper feel: a narrow news sans for headlines over a readable serif, a masthead rule and coral red. Clear and wordy, for reports, newsletters, briefings, essays and research talks.",
 "good_for": [
  "report",
  "newsletter",
  "briefing",
  "essay",
  "research",
  "story"
 ],
 "category": "editorial",
 "also": [
  "academic"
 ],
 "credit": "colours and fonts from Bootswatch Journal by Thomas Park (MIT licence)",
 "defaults": {
  "mode": "light",
  "palette": "coral"
 },
 "fonts": {
  "display": [
   "News Cycle",
   "sans"
  ],
  "body": [
   "Source Serif 4",
   "serif"
  ],
  "label": [
   "News Cycle",
   "sans"
  ],
  "stat": [
   "News Cycle",
   "sans"
  ],
  "mono": [
   "IBM Plex Mono",
   "mono"
  ]
 },
 "tokens": {
  "--w-display": "700",
  "--w-h1": "700",
  "--w-h2": "700",
  "--w-body": "400",
  "--w-strong": "700",
  "--w-label": "700",
  "--w-stat": "700",
  "--track-display": "-0.01em",
  "--track-h1": "0em",
  "--track-label": "0.06em",
  "--label-case": "uppercase",
  "--lh-display": "1.04",
  "--lh-h1": "1.1",
  "--lh-body": "1.55",
  "--radius": "0px",
  "--radius-sm": "0px",
  "--border-w": "1px",
  "--card-pad": "34px",
  "--icon-stroke": "1.75"
 },
 "modes": {
  "light": {
   "bg": "#FFFFFF",
   "bg_alt": "#F8F6F2",
   "surface": "#FFFFFF",
   "surface_2": "#F1EEE8",
   "ink": "#222222",
   "ink_2": "#444444",
   "ink_3": "#5C5C5C",
   "line": "#DDDDDD",
   "positive": "#1E8A43",
   "negative": "#C0392B",
   "warning": "#A35A00",
   "code_bg": "#222222",
   "code_ink": "#F8F6F2",
   "letterbox": "#111111",
   "shadow": "none"
  },
  "dark": {
   "bg": "#1A1A1A",
   "bg_alt": "#202020",
   "surface": "#242424",
   "surface_2": "#2E2E2E",
   "ink": "#F2F0EC",
   "ink_2": "#CFCCC6",
   "ink_3": "#A9A6A0",
   "line": "#3A3A3A",
   "positive": "#6FD08C",
   "negative": "#F28B82",
   "warning": "#F5B041",
   "code_bg": "#111111",
   "code_ink": "#F2F0EC",
   "letterbox": "#000000",
   "shadow": "none"
  }
 },
 "palettes": {
  "coral": {
